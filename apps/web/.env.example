# Wallet / RPC (required for connect + transacting)
NEXT_PUBLIC_INFURA_TOKEN=1234567890
NEXT_PUBLIC_WC_PROJECT_ID=0987654321

NEXT_PUBLIC_IS_OFFICIAL_HOST=false

# Analytics (placeholder for local runs)
NEXT_PUBLIC_PROD_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here
NEXT_PUBLIC_STAGING_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here, too

# --- Local Docker stack (e.g. safe-infrastructure-v2 on port 8000) ---
# With NEXT_PUBLIC_IS_PRODUCTION=false (dev), Gateway URL comes from STAGING unless you toggle debugProdCgw.
NEXT_PUBLIC_GATEWAY_URL_STAGING=http://localhost:8000/cgw
NEXT_PUBLIC_GATEWAY_URL_PRODUCTION=http://localhost:8000/cgw
NEXT_PUBLIC_DEFAULT_TESTNET_CHAIN_ID=1001
NEXT_PUBLIC_DEFAULT_MAINNET_CHAIN_ID=1001
